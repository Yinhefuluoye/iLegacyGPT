{
  "compilerOptions": {
    "target": "ES5",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["DOM", "ES2015"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "downlevelIteration": true,
    "rootDir": "src",
    "outDir": ".build/es5",
    "noEmit": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}